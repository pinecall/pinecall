# The runtime: one image for every process of a cluster — gateway, worker, overflow, migrations,
# the CronJobs — each a different `pinecall-runtime` verb. It is a function of one commit and of
# nothing else: the build's context is that commit's tree (`make image` sends `git archive`), so
# what no commit holds cannot be in it. Three stages: the console and the widget from the
# lockfile, the wheel with those pages inside, and the image that installs it with the voice
# plugins and Smart Turn v3's weights, so a pod never reaches the internet to start. Nothing secret
# is in it: every key comes from the pod's environment at run time.

# Each base by the digest of its multi-architecture index: the tag says which one, the digest is
# what is pulled, and two builds of one commit start from the same bytes.
ARG NODE=docker.io/library/node:24-trixie-slim@sha256:6418e1ff99a5db6608cd55a020036dde6b7d18df9a0b7e44209b4ef5891766fb
ARG PYTHON=docker.io/library/python:3.13-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
ARG UV=ghcr.io/astral-sh/uv:0.9.30@sha256:538e0b39736e7feae937a65983e49d2ab75e1559d35041f9878b7b7e51de91e4

FROM ${UV} AS uv

# The pages: the console and what it takes from the workspace (packages/core), installed from
# pnpm-lock.yaml and refused when the lock and a manifest disagree; pnpm is the version the root
# package.json names. scripts/console is the one way they are built, here and for PyPI's wheel.
FROM ${NODE} AS pages
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
WORKDIR /repo
COPY . .
RUN corepack enable \
 && pnpm install --frozen-lockfile --filter "@pinecall/console..." \
 && runtime/scripts/console

# The wheel, with the pages inside (scripts/hatch_build.py refuses a wheel without them), and
# uv.lock's voice dependencies exported with their hashes.
FROM ${PYTHON} AS wheel
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never
WORKDIR /repo/runtime
COPY runtime .
COPY --from=pages /repo/runtime/build/public build/public
RUN uv build --wheel --quiet --out-dir /out \
 && uv export --locked --extra voice --no-dev --no-emit-project --quiet -o /out/requirements.txt

FROM ${PYTHON}
# Every dependency is the locked version, refused unless its hash matches, so two builds of one
# commit install the same bytes; the wheel adds none. uv and the wheel are mounted for this step
# and stay out of the image.
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=type=bind,from=wheel,source=/out,target=/out \
    uv pip install --system --no-cache --require-hashes -r /out/requirements.txt \
 && uv pip install --system --no-cache --no-deps /out/pinecall_runtime-*.whl
# Smart Turn v3, the second end-of-turn model, is fetched from Hugging Face on first use; here it
# is fetched once, at build, and the pod runs offline. livekit's own (v1-mini) is in its library.
# Pinned to the repository's commit and checked by its hash: two builds of one commit carry the
# same weights, and SMART_TURN_MODEL makes the library read that file and no other.
ENV HF_HOME=/opt/models
ARG SMART_TURN_REVISION=f766f81d3cfdf7737ac64aad813d91bbfd56bf93
ARG SMART_TURN_SHA256=2bb026316b14a660486a75b1733cd3fbab8c2fd0314dc9af7be49f8cca967e4f
RUN python -c "import hashlib, sys, huggingface_hub as hub; \
path = hub.hf_hub_download('pipecat-ai/smart-turn-v3', 'smart-turn-v3.2-cpu.onnx', revision=sys.argv[1]); \
digest = hashlib.sha256(open(path, 'rb').read()).hexdigest(); \
sys.exit(f'{path}: sha256 {digest}, not {sys.argv[2]}') if digest != sys.argv[2] else print(path)" \
  "${SMART_TURN_REVISION}" "${SMART_TURN_SHA256}"
ENV SMART_TURN_MODEL=/opt/models/hub/models--pipecat-ai--smart-turn-v3/snapshots/${SMART_TURN_REVISION}/smart-turn-v3.2-cpu.onnx
ENV HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin pinecall
USER 10001
ENTRYPOINT ["pinecall-runtime"]
