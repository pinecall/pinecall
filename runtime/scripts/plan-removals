#!/usr/bin/env python3
"""Reads a Terraform plan as JSON on stdin and names what it deletes or replaces; exit 1 when it names any."""

import json
import sys


def main() -> int:
    plan = json.load(sys.stdin)
    removed = [
        (change["address"], "replaced" if "create" in change["change"]["actions"] else "deleted")
        for change in plan.get("resource_changes", [])
        if "delete" in change["change"]["actions"]
    ]
    for address, fate in removed:
        print(f"  {fate}: {address}", file=sys.stderr)
    return 1 if removed else 0


sys.exit(main())
