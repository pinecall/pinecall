#!/usr/bin/env python3
"""An env's warm scaled workers, changed on the values' one line and committed: fleet <values> <env> <min> [most]."""

import re
import subprocess
import sys
from pathlib import Path

ENVS = ("production", "sandbox")
TOP = re.compile(r"^[^\s#]")
ENV = re.compile(r"^\s+(?P<env>production|sandbox):\s*$")
LINE = re.compile(r"^(?P<indent>\s+)scaled: \{ seats: (?P<seats>\d+), most: (?P<most>\d+), min: (?P<min>\d+) \}$")


def count(n: int, noun: str) -> str:
    """`1 scaled worker`, `2 scaled workers`."""
    return f"{n} {noun}" if n == 1 else f"{n} {noun}s"


def scaled(lines: list[str], env: str) -> list[int]:
    """Which lines write `envs.<env>.workers.scaled`: a `scaled:` line under that env's key of `envs:`."""
    hits: list[int] = []
    in_envs, under = False, ""
    for at, line in enumerate(lines):
        if TOP.match(line):
            in_envs, under = line.rstrip() == "envs:", ""
        elif in_envs and (key := ENV.match(line)):
            under = key["env"]
        elif under == env and LINE.match(line):
            hits.append(at)
    return hits


def main(argv: list[str]) -> None:
    """Rewrites `envs.<env>.workers.scaled` in the values, prints the line, commits it where the values live."""
    if len(argv) not in (4, 5):
        sys.exit("fleet <values.yaml> <env> <min> [<most>]")
    path, env, floor = Path(argv[1]), argv[2], int(argv[3])
    if env not in ENVS:
        sys.exit(f"{env} is no env: production or sandbox")
    lines = path.read_text().splitlines(keepends=True)
    hits = scaled(lines, env)
    if len(hits) != 1:
        shape = "scaled: { seats: N, most: N, min: N }"
        sys.exit(f"{path} needs one line `{shape}` under envs.{env}.workers, and has {len(hits)}")
    at = hits[0]
    found = LINE.match(lines[at])
    assert found is not None
    most = int(argv[4]) if len(argv) == 5 else int(found["most"])
    if floor > most:
        sys.exit(f"min {floor} is over most {most}: MOST=<n> raises the ceiling with it")
    lines[at] = f"{found['indent']}scaled: {{ seats: {found['seats']}, most: {most}, min: {floor} }}\n"
    path.write_text("".join(lines))
    print(lines[at].strip())
    ops = path.resolve().parent.parent
    tracked = subprocess.run(
        ["git", "-C", str(ops), "ls-files", "--error-unmatch", str(path.resolve())], capture_output=True
    )
    if tracked.returncode != 0:
        print(f"{path} is not tracked by git: written, not committed")
        return
    if subprocess.run(["git", "-C", str(ops), "diff", "--quiet", "--", str(path.resolve())]).returncode == 0:
        print(f"{path.name} already said so; nothing to commit")
        return
    message = f"{path.stem}: the {env} keeps {count(floor, 'scaled worker')} warm, {most} at most"
    subprocess.run(["git", "-C", str(ops), "commit", "-q", "-m", message, "--", str(path.resolve())], check=True)
    print(f"committed in {ops}: {message}")


main(sys.argv)
