{
  // The tenant preset first — test fixtures are tenant classes — then this repo's strictness.
  "extends": "@pinecall/agents/tsconfig.tenant.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // The wizard's screens are React elements for Ink; a tenant's views, which the preset compiles against the framework's runtime, are never built here.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src"]
}
