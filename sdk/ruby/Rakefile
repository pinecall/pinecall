# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |task|
  task.libs = %w[lib test]
  task.test_files = FileList["test/**/*_test.rb"]
  task.warning = false
end

# The example is loaded as the one CLI loads it: its app and both agents, read by this checkout's gem.
desc "The example loads: its app and its agents, the way the pinecall CLI reads them"
task :examples do
  ruby "-I#{File.expand_path("lib", __dir__)} -r pinecall -e 'exit Pinecall::Serve.main(ARGV)' -- app --app app.rb " \
       "--file agents/clinic-front-desk/agent.rb --slug clinic-front-desk " \
       "--file agents/clinic-billing/agent.rb --slug clinic-billing", chdir: "../../examples/ruby/brightside_dental"
end

# Ring 1 needs the one CLI and a key, so it is not part of `check`: the repository's nightly
# runs it. Without either it says what is missing and leaves.
desc "Ring 1: the example's goldens, through the one pinecall CLI and the gateway"
task :ring1 do
  checkout = File.expand_path("../../cli/bin/pinecall.js", __dir__)
  cli = File.exist?(checkout) ? ["node", checkout] : (system("command -v pinecall >/dev/null") ? ["pinecall"] : nil)
  next puts("ring1: no pinecall CLI here — npm i -g pinecall, or the repository's cli/ (../../cli)") if cli.nil?
  next puts("ring1: no PINECALL_KEY — pinecall login in examples/ruby/brightside_dental") if ENV["PINECALL_KEY"].to_s.empty? && !File.exist?("../../examples/ruby/brightside_dental/.env")

  # The gem is this checkout's: the serve entry the CLI starts loads it from lib/.
  sh({ "RUBYLIB" => File.expand_path("lib", __dir__) }, *cli, "test", chdir: "../../examples/ruby/brightside_dental")
end

desc "Check the signatures against RBS"
task :rbs do
  sh "rbs -I sig validate"
end

desc "What CI runs: the tests, the example's own suite, then the signatures"
task check: %i[test examples rbs]

task default: :check
