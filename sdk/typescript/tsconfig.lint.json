{
  // The lint config: the build's compiler options, over the tests as well, so a fixture that
  // stops compiling is caught by `pnpm lint` and not by the next person to read it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "test"]
}
