# The key every verb in this folder reads. `pinecall link` writes it here, for the org you pick;
# a server keeps a server's token from the console's API keys screen in its own secrets instead.
PINECALL_KEY=
# Only when the gateway is not https://cloud.pinecall.io — `link --gateway <url>` writes it too.
# PINECALL_URL=http://127.0.0.1:8080
# The dot's door (site/serve.mjs's /pinecall/ask) decides what the visitor types with Jev, through
# OpenRouter: an OpenRouter key.
OPENROUTER_API_KEY=
