{
  "name": "@pinecall/room",
  "version": "0.11.17",
  "description": "The caller's side of a Pinecall call in a browser: one store, the seat and the log joined, no framework",
  "license": "Apache-2.0",
  "author": "Pinecall <hello@pinecall.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinecall/pinecall.git",
    "directory": "packages/room"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "scripts/build",
    "lint": "tsc -p tsconfig.lint.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "livekit-client": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "livekit-client": "^2.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      }
    }
  }
}
