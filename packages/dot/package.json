{
  "name": "@pinecall/dot",
  "version": "0.11.20",
  "description": "The talking dot: a face that speaks with the agent's voice, and a tutor that walks the page with a pointer of its own",
  "license": "Apache-2.0",
  "author": "Pinecall <hello@pinecall.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinecall/pinecall.git",
    "directory": "packages/dot"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts",
      "default": "./src/agent/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "scripts/build",
    "lint": "tsc -p tsconfig.lint.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pinecall/room": "workspace:^"
  },
  "peerDependencies": {
    "@pinecall/agents": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pinecall/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pinecall/agents": "workspace:^",
    "@types/node": "^26.4.1",
    "happy-dom": "^20.14.5",
    "livekit-client": "^2.22.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./agent": {
        "types": "./dist/agent/index.d.ts",
        "import": "./dist/agent/index.js"
      }
    }
  }
}
